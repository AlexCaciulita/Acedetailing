# Nova Detailing - Environment Variables
# Copy this file to .env and fill in the values

# ============================================
# PayU Payment Gateway
# ============================================
PAYU_MERCHANT_ID=
PAYU_POS_ID=
PAYU_SECRET_KEY=
PAYU_API_URL=https://secure.snd.payu.com/api/v2_1/orders
PAYU_RETURN_URL=https://novadetailing.ro/rezervare.html?status=return
PAYU_NOTIFY_URL=https://novadetailing.ro/api/payu-notify

# ============================================
# Email Service
# ============================================
EMAIL_SERVICE_URL=
EMAIL_API_KEY=
BUSINESS_EMAIL=contact@novadetailing.ro

# ============================================
# AI Chat Assistant (OpenRouter)
# ============================================
OPENROUTER_API_KEY=

# ============================================
# Server
# ============================================
PORT=8000

# ============================================
# Panou de administrare (/admin)
# ============================================
# Fara aceasta valoare, /api/admin refuza orice cerere (fail-closed).
# Genereaza hash-ul cu:  npm run admin:password
# Parola in clar NU se stocheaza nicaieri.
ADMIN_PASSWORD_HASH=

# Seteaza 1 doar daca serverul ruleaza in spatele unui reverse proxy de
# incredere; altfel X-Forwarded-For poate fi falsificat pentru a ocoli
# limitarea incercarilor de autentificare.
TRUST_PROXY=0

# Optional: director persistent pentru datele admin/CRM. Daca lipseste,
# aplicatia foloseste folderul local ./data.
NOVA_DATA_DIR=
